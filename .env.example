# Backend Delphi legado — não usado mais pelo apiFetch (multi-tenant por CNPJ
# via giro360_backend, ver VPS_URL abaixo). Mantido só de referência.
BACKEND_URL=http://localhost:3000
BACKEND_USER=admin
BACKEND_PASS=

# Filial padrão (fallback antes de qualquer cookie de sessão)
FILIAL=1

# giro360_backend — mesma API que giro_web e petshop_web usam em produção.
# Usado só server-side (aplicacao='petshop_web' em toda chamada) — captcha/
# registro/status passam por proxy local (src/app/api/giro/*) pra não
# depender de CORS_ORIGINS liberar a origem do petshop_web na VPS.
VPS_URL=https://api-giro.logidoc.pro
NEXT_PUBLIC_VPS_URL=https://api-giro.logidoc.pro

# Chave exigida em GET /giro/token (header X-App-Key) — SÓ server-side, nunca
# em variável NEXT_PUBLIC_*. Peça o valor real de produção; não commitar aqui.
APP_TOKEN_KEY=

# Integração Petlove (Configurações > Integrações, senha 102030) — não existe
# API pública documentada; preencher só se/quando a Petlove fornecer um
# contrato de parceria com URL base + token. Sem isso a tela mostra simulação.
PETLOVE_API_URL=
PETLOVE_API_TOKEN=
